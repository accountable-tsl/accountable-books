generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  users       User[]    @relation("userRole")

  @@index([id])
  @@index([name])
}

model User {
  id                            String                 @id @default(uuid())
  firstname                     String
  lastname                      String?
  email                         String                 @unique
  password                      String
  phoneNumber                   String?
  status                        UserStatus             @default(ACTIVE)
  roleId                        String
  profileImage                  String?
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt
  deletedAt                     DateTime?
  isDeleted                     Boolean                @default(false)
  bankTransactionBatchesCreated BankTransactionBatch[] @relation("createdByUser")
  bankTransactionBatchesUpdated BankTransactionBatch[] @relation("updatedByUser")
  createdCompanies              Company[]              @relation("companyCreator")
  JournalBatchCreatedBy         JournalBatch[]         @relation("journalBatchCreatedBy")
  JournalBatchPostedBy          JournalBatch[]         @relation("journalPostedBy")
  journalEntryReversed          JournalBatch[]         @relation("JournalBatchReversedBy")
  JournalBatchUpdatedBy         JournalBatch[]         @relation("journalUpdatedBy")
  ledgerTransactionCreated      LedgerTransaction[]    @relation("ledgerTransactionCreatedBy")
  ledgerTransactionUpdated      LedgerTransaction[]    @relation("ledgerTransactionUpdatedBy")
  role                          Role                   @relation("userRole", fields: [roleId], references: [id])
  companies                     UserCompany[]          @relation("userCompanies")

  @@index([email, status])
}

model Company {
  id                       String                     @id @default(uuid())
  name                     String
  shortCode                String                     @unique
  website                  String?
  industry                 String?
  teamSize                 String?
  revenue                  String?
  yearEndDay               Int
  yearEndMonth             Int
  countryId                String
  reportingCurrencyId      String
  createdById              String
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  deletedAt                DateTime?
  isDeleted                Boolean                    @default(false)
  bankAccounts             BankAccount[]              @relation("companyBankAccounts")
  coa                      Coa[]                      @relation("companyCoa")
  country                  Country                    @relation("companyCountry", fields: [countryId], references: [id])
  createdBy                User                       @relation("companyCreator", fields: [createdById], references: [id])
  reportingCurrency        Currency                   @relation("companyCurrency", fields: [reportingCurrencyId], references: [id])
  contacts                 Contact[]                  @relation("companyContacts")
  currentAccountingPeriod  CurrentAccountingPeriod?   @relation("CompanyCurrentAccountingPeriod")
  journalBatches           JournalBatch[]             @relation("companyJournals")
  ledgerTransactions       LedgerTransaction[]        @relation("companyLedgerTransactions")
  projects                 Project[]                  @relation("companyProjects")
  recurringJournalTemplate RecurringJournalTemplate[] @relation("companyRecurringJournals")
  users                    UserCompany[]              @relation("companyUsers")

  @@index([name])
  @@index([shortCode])
  @@index([countryId])
}

model UserCompany {
  userId    String
  companyId String
  role      UserCompanyRole
  joinedAt  DateTime        @default(now())
  company   Company         @relation("companyUsers", fields: [companyId], references: [id])
  user      User            @relation("userCompanies", fields: [userId], references: [id])

  @@id([userId, companyId])
  @@index([userId, companyId])
}

model Currency {
  id                 String         @id @default(uuid())
  code               String         @unique
  name               String         @unique
  symbol             String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  isDeleted          Boolean        @default(false)
  deletedAt          DateTime?
  bankAccounts       BankAccount[]  @relation("bankAccountCurrency")
  coa                Coa[]          @relation("coaCurrency")
  companies          Company[]      @relation("companyCurrency")
  exchangeRateBase   ExchangeRate[] @relation("fromCurrency")
  exchangeRateTarget ExchangeRate[] @relation("toCurrency")

  @@index([code])
}

model Country {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  phoneCode String
  flag      String?
  continent String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  banks     Bank[]    @relation("bankCountry")
  company   Company[] @relation("companyCountry")
}

model FinancialStatement {
  id             String           @id @default(uuid())
  statementKey   FsKey            @unique
  usGaapLabel    String
  ifrsLabel      String
  defaultLabel   String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  isDeleted      Boolean          @default(false)
  deletedAt      DateTime?
  accountElement AccountElement[] @relation("fsElement")
}

model AccountElement {
  id                   String             @id @default(uuid())
  elementName          String
  defaultSide          DebitCredit
  parentId             String?
  financialStatementId String
  description          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  isDeleted            Boolean            @default(false)
  deletedAt            DateTime?
  financialStatement   FinancialStatement @relation("fsElement", fields: [financialStatementId], references: [id])
  parent               AccountElement?    @relation("parentChildRelation", fields: [parentId], references: [id])
  children             AccountElement[]   @relation("parentChildRelation")
  accountType          AccountType[]      @relation("typeElement")
}

model AccountType {
  id               String         @id @default(uuid())
  typeName         String         @unique @db.VarChar(255)
  accountElementId String
  description      String?        @db.VarChar(255)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  isDeleted        Boolean        @default(false)
  deletedAt        DateTime?
  accountElement   AccountElement @relation("typeElement", fields: [accountElementId], references: [id])
  coa              Coa[]          @relation("coaAccountType")
}

model Coa {
  id             String                 @id @default(uuid())
  fsKey          FsKey
  accountCode    String?
  accountName    String
  description    String?
  accountTypeId  String
  defaultSide    DebitCredit
  currencyId     String
  companyId      String
  isActive       Boolean                @default(true)
  bankAccountId  String?                @unique
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  isDeleted      Boolean                @default(false)
  deletedAt      DateTime?
  bankAccount    BankAccount?           @relation("bankCoaAccount")
  accountType    AccountType            @relation("coaAccountType", fields: [accountTypeId], references: [id])
  company        Company                @relation("companyCoa", fields: [companyId], references: [id])
  currency       Currency               @relation("coaCurrency", fields: [currencyId], references: [id])
  journalEntries JournalEntry[]         @relation("journalEntries")
  liveCoaBalance LiveCoaAccountBalance? @relation("LiveCoaAccountBalance")

  @@unique([accountName, companyId])
  @@unique([accountCode, companyId])
  @@index([companyId])
  @@index([companyId, isDeleted])
}

model CoaTemplate {
  id            String      @id @default(uuid())
  templateName  String
  accountCode   String
  accountName   String
  accountTypeId String
  defaultSide   DebitCredit
  fsKey         String?
  description   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  isDeleted     Boolean     @default(false)
}

model Bank {
  id           String        @id @default(uuid())
  name         String
  bankLogo     String?
  countryId    String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  isDeleted    Boolean       @default(false)
  deletedAt    DateTime?
  country      Country       @relation("bankCountry", fields: [countryId], references: [id])
  bankAccounts BankAccount[] @relation("bankStatements")
}

model BankAccount {
  id                       String                  @id @default(uuid())
  bankId                   String
  displayName              String
  bankAccountType          BankAccountType
  bankAccountNo            String
  bankBalance              Decimal                 @default(0)
  lastReconciled           DateTime?
  currencyId               String
  companyId                String
  coaId                    String                  @unique
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  isDeleted                Boolean                 @default(false)
  deletedAt                DateTime?
  liveBankAccountBalanceId String?
  bank                     Bank                    @relation("bankStatements", fields: [bankId], references: [id])
  accountInCoa             Coa                     @relation("bankCoaAccount", fields: [coaId], references: [id])
  company                  Company                 @relation("companyBankAccounts", fields: [companyId], references: [id])
  currency                 Currency                @relation("bankAccountCurrency", fields: [currencyId], references: [id])
  transactionBatches       BankTransactionBatch[]  @relation("transactionBatches")
  liveAccountBalance       LiveBankAccountBalance? @relation("bankAccountLiveBalance")
  ledgerBalance            LiveBankLedgerBalance?  @relation("BankLedgerBalance")

  @@unique([companyId, bankAccountNo, bankId])
  @@index([companyId])
  @@index([currencyId])
}

model BankTransactionBatch {
  id            String                @id @default(uuid())
  importedDate  DateTime              @default(now())
  startDate     DateTime
  endDate       DateTime
  balanceBefore Decimal
  balanceAfter  Decimal
  source        BankTransactionSource
  bankAccountId String
  createdById   String
  updatedById   String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  isDeleted     Boolean               @default(false)
  deletedAt     DateTime?
  bankAccount   BankAccount           @relation("transactionBatches", fields: [bankAccountId], references: [id])
  createdBy     User                  @relation("createdByUser", fields: [createdById], references: [id])
  updatedBy     User?                 @relation("updatedByUser", fields: [updatedById], references: [id])

  @@index([bankAccountId])
  @@index([startDate, endDate])
}

model BankTransaction {
  id                     String               @default(uuid())
  date                   DateTime
  payee                  String?
  reference              String?
  description            String?
  additionalComments     String?
  transactionSide        DebitCredit?
  amount                 Decimal
  absoluteAmount         Decimal              @default(0)
  systemExchangeRate     Decimal
  categorisationStatus   CategorisationStatus @default(UNCATEGORISED)
  bankAccountId          String
  bankTransactionBatchId String?
  ledgerTransactionId    String?
  createdById            String
  updatedById            String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  isDeleted              Boolean              @default(false)
  deletedAt              DateTime?

  @@id([id, date], map: "BankTransaction_pkey1")
  @@unique([id, date], map: "BankTransaction_id_date_idx2")
  @@index([bankTransactionBatchId], map: "BankTransaction_bankTransactionBatchId_idx1")
  @@index([date], map: "BankTransaction_date_idx1")
  @@index([id, date], map: "BankTransaction_id_date_idx1")
  @@index([ledgerTransactionId], map: "BankTransaction_ledgerTransactionId_idx1")
  @@index([bankTransactionBatchId], map: "banktx_batch_id_idx")
  @@index([categorisationStatus], map: "banktx_categorisation_status_idx")
  @@index([date], map: "banktx_date_idx")
  @@map("BankTransaction")
  @@ignore
}

model LedgerTransaction {
  id                  String            @id @default(uuid())
  date                DateTime
  contactId           String?
  description         String?
  source              TransactionSource
  reference           String?
  bankTransactionId   String?
  bankTransactionDate DateTime?
  companyId           String
  notes               String?
  createdById         String
  updatedById         String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  isDeleted           Boolean           @default(false)
  deletedAt           DateTime?
  journalBatch        JournalBatch?     @relation("journalLedgerTransactions")
  company             Company           @relation("companyLedgerTransactions", fields: [companyId], references: [id])
  contact             Contact?          @relation("contactLedgerTransactions", fields: [contactId], references: [id])
  createdBy           User              @relation("ledgerTransactionCreatedBy", fields: [createdById], references: [id])
  updatedBy           User?             @relation("ledgerTransactionUpdatedBy", fields: [updatedById], references: [id])

  @@unique([bankTransactionId, bankTransactionDate])
  @@index([date])
  @@index([source])
  @@index([contactId])
  @@index([companyId])
  @@index([bankTransactionId])
}

model LedgerEntry {
  id                   String               @default(uuid())
  ledgerTransactionId  String
  fsDate               DateTime
  coaId                String
  transactionSide      DebitCredit
  sourceCurrencyId     String
  sourceAmount         Decimal
  absoluteSourceAmount Decimal
  systemExchangeRate   Decimal
  customExchangeRate   Decimal
  amount               Decimal
  absoluteAmount       Decimal
  categorisationStatus CategorisationStatus @default(AUTO_CATEGORISED)
  description          String?
  projectId            String?
  updatedById          String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  deletedAt            DateTime?
  isDeleted            Boolean              @default(false)

  @@id([id, fsDate], map: "LedgerEntry_pkey1")
  @@unique([id, fsDate], map: "LedgerEntry_id_fsDate_idx")
  @@index([categorisationStatus], map: "LedgerEntry_categorisationStatus_idx1")
  @@index([coaId, fsDate], map: "LedgerEntry_coaId_fsDate_idx1")
  @@index([coaId, isDeleted], map: "LedgerEntry_coaId_isDeleted_idx1")
  @@index([fsDate], map: "LedgerEntry_fsDate_idx1")
  @@index([ledgerTransactionId], map: "LedgerEntry_ledgerTransactionId_idx1")
  @@index([coaId, fsDate], map: "ledger_entry_coaid_fsdate_idx")
  @@index([fsDate], map: "ledger_entry_fsdate_idx")
  @@map("LedgerEntry")
  @@ignore
}

model JournalBatch {
  id                      String                    @id @default(uuid())
  sequenceNumber          Int?
  date                    DateTime
  description             String
  note                    String?
  status                  JournalStatus
  generatedFromTemplateId String?
  ledgerTransactionId     String?                   @unique
  postedAt                DateTime?
  postedById              String?
  updatedById             String?
  companyId               String
  autoReversalDate        DateTime?
  reversedJournalId       String?
  reversedById            String?
  reversedAt              DateTime?
  reversalReason          JournalReversalReason?
  createdById             String
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  isDeleted               Boolean                   @default(false)
  deletedAt               DateTime?
  company                 Company                   @relation("companyJournals", fields: [companyId], references: [id])
  CreatedBy               User                      @relation("journalBatchCreatedBy", fields: [createdById], references: [id])
  generatedFromTemplate   RecurringJournalTemplate? @relation("GeneratedFromTemplate", fields: [generatedFromTemplateId], references: [id])
  ledgerTransactions      LedgerTransaction?        @relation("journalLedgerTransactions", fields: [ledgerTransactionId], references: [id])
  postedBy                User?                     @relation("journalPostedBy", fields: [postedById], references: [id])
  reversedBy              User?                     @relation("JournalBatchReversedBy", fields: [reversedById], references: [id])
  reversedJournal         JournalBatch?             @relation("JournalReversals", fields: [reversedJournalId], references: [id])
  reversingJournals       JournalBatch[]            @relation("JournalReversals")
  updatedBy               User?                     @relation("journalUpdatedBy", fields: [updatedById], references: [id])
  journalTransactions     JournalEntry[]            @relation("journalTransactions")

  @@unique([companyId, sequenceNumber])
  @@index([status, companyId])
}

model JournalEntry {
  id                String       @id @default(uuid())
  description       String?
  side              DebitCredit
  amount            Decimal
  journalBatchId    String
  coaAccountId      String
  ledgerEntryId     String?
  ledgerEntryfsDate DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  isDeleted         Boolean      @default(false)
  coaAccount        Coa          @relation("journalEntries", fields: [coaAccountId], references: [id])
  journalBatch      JournalBatch @relation("journalTransactions", fields: [journalBatchId], references: [id])

  @@unique([ledgerEntryId, ledgerEntryfsDate])
  @@index([journalBatchId])
}

model RecurringJournalTemplate {
  id                      String                          @id @default(uuid())
  description             String
  note                    String?
  status                  RecurringJournalStatus
  companyId               String
  frequency               RecurrenceFrequency
  startDate               DateTime
  endDate                 DateTime?
  nextRunDate             DateTime?
  placeholderVars         Json?
  createdAt               DateTime                        @default(now())
  updatedAt               DateTime                        @updatedAt
  deletedAt               DateTime?
  isDeleted               Boolean                         @default(false)
  generatedJournalBatches JournalBatch[]                  @relation("GeneratedFromTemplate")
  company                 Company                         @relation("companyRecurringJournals", fields: [companyId], references: [id])
  journalEntries          RecurringJournalTemplateEntry[]

  @@index([frequency, nextRunDate])
}

model RecurringJournalTemplateEntry {
  id                        String                   @id @default(uuid())
  description               String
  amount                    Decimal
  side                      DebitCredit
  coaAccountId              String
  placeholderDescriptionVar String?
  templateId                String
  template                  RecurringJournalTemplate @relation(fields: [templateId], references: [id])
}

model ExchangeRate {
  id             String    @id @default(uuid())
  date           DateTime
  fromCurrencyId String
  toCurrencyId   String
  rate           Decimal
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  isDeleted      Boolean   @default(false)
  fromCurrency   Currency  @relation("fromCurrency", fields: [fromCurrencyId], references: [id])
  toCurrency     Currency  @relation("toCurrency", fields: [toCurrencyId], references: [id])

  @@unique([fromCurrencyId, toCurrencyId, date])
}

model Contact {
  id             String              @id @default(uuid())
  contactCode    String?
  name           String
  description    String?
  primaryEmail   String?
  secondaryEmail String?
  address        String?
  website        String?
  businessRegNo  String?
  contactType    ContactType?
  companyId      String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?
  isDeleted      Boolean             @default(false)
  company        Company             @relation("companyContacts", fields: [companyId], references: [id])
  transactions   LedgerTransaction[] @relation("contactLedgerTransactions")
  projects       Project[]           @relation("ProjectContact")

  @@unique([name, companyId])
}

model Project {
  id          String         @id @default(uuid())
  code        String?
  name        String
  description String?
  status      ProjectStatus? @default(IN_DRAFT)
  contactId   String?
  companyId   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  isDeleted   Boolean        @default(false)
  company     Company        @relation("companyProjects", fields: [companyId], references: [id])
  contact     Contact?       @relation("ProjectContact", fields: [contactId], references: [id])

  @@unique([code, companyId])
  @@unique([name, companyId])
}

model LiveBankAccountBalance {
  id            String      @id @default(uuid())
  bankAccountId String      @unique
  nativeBalance Decimal
  updatedAt     DateTime    @updatedAt
  bankAccount   BankAccount @relation("bankAccountLiveBalance", fields: [bankAccountId], references: [id])
}

model LiveBankLedgerBalance {
  id               String      @id @default(uuid())
  bankAccountId    String      @unique
  nativeBalance    Decimal
  reportingBalance Decimal
  updatedAt        DateTime    @updatedAt
  bankAccount      BankAccount @relation("BankLedgerBalance", fields: [bankAccountId], references: [id])
}

model LiveCoaAccountBalance {
  id          String   @id @default(uuid())
  coaId       String   @unique
  liveBalance Decimal
  updatedAt   DateTime @updatedAt
  coa         Coa      @relation("LiveCoaAccountBalance", fields: [coaId], references: [id])

  @@index([coaId])
}

model PLBalanceSnapshot {
  id             String             @id @default(uuid())
  coaId          String
  periodStart    DateTime
  periodEnd      DateTime
  periodType     SnapshotPeriodType
  openingBalance Decimal
  totalMovement  Decimal
  closingBalance Decimal
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([coaId, periodStart, periodEnd])
  @@index([periodStart])
  @@index([coaId, periodEnd])
  @@index([coaId, periodStart, periodEnd])
}

model BalanceSheetSnapshot {
  id                String   @id @default(uuid())
  coaId             String
  snapshotDate      DateTime
  cumulativeBalance Decimal
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([coaId, snapshotDate])
  @@index([coaId, snapshotDate])
}

model CurrentAccountingPeriod {
  id          String   @id @default(uuid())
  companyId   String   @unique
  periodStart DateTime
  periodEnd   DateTime
  updatedAt   DateTime @updatedAt
  company     Company  @relation("CompanyCurrentAccountingPeriod", fields: [companyId], references: [id])

  @@index([companyId])
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserCompanyRole {
  ADMIN
  BOOKKEEPER
  VIEWER
}

enum FsKey {
  BALANCE_SHEET
  INCOME_STATEMENT
}

enum DebitCredit {
  DEBIT
  CREDIT
}

enum BankTransactionSource {
  FILE_IMPORT
  BANK_FEED
  MANUAL_ENTRY
}

enum BankAccountType {
  OTHER
  CREDIT_CARD
  DEBIT_CARD
  SAVINGS
  CHECKINGS_CURRENT
  UTILITY
}

enum CategorisationStatus {
  UNCATEGORISED
  AUTO_CATEGORISED
  CATEGORISED
}

enum TransactionSource {
  BANK
  MANUAL_JOURNAL
  SYSTEM
}

enum JournalStatus {
  DRAFT
  POSTED
  VOIDED
}

enum JournalReversalReason {
  AUTO_REVERSAL
  VOIDED
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurringJournalStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum ContactType {
  SUPPLIER
  CUSTOMER
  EMPLOYEE
}

enum ProjectStatus {
  IN_DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum SnapshotPeriodType {
  MONTH
  QUARTER
  ANNUAL
}
