// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String    @id @default(uuid())
  name        String    @unique //accountant, admin, client
  description String?
  users       User[]    @relation(name: "userRole")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?

  @@index([id])
  @@index([name])
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id                            String                 @id @default(uuid())
  firstname                     String
  lastname                      String?
  email                         String                 @unique
  password                      String
  phoneNumber                   String?
  status                        UserStatus             @default(ACTIVE)
  roleId                        String
  role                          Role                   @relation(name: "userRole", fields: [roleId], references: [id])
  profileImage                  String?
  companies                     UserCompany[]          @relation(name: "userCompanies")
  createdCompanies              Company[]              @relation("companyCreator")
  JournalBatchPostedBy          JournalBatch[]         @relation("journalPostedBy")
  JournalBatchUpdatedBy         JournalBatch[]         @relation("journalUpdatedBy")
  bankTransactionBatchesCreated BankTransactionBatch[] @relation("createdByUser")
  bankTransactionBatchesUpdated BankTransactionBatch[] @relation("updatedByUser")
  bankTransactionsCategorised   BankTransaction[]      @relation("categorisedByUser")
  bankTransactionCreated        BankTransaction[]      @relation(name: "bankTransactionCreatedBy")
  bankTransactionUpdated        BankTransaction[]      @relation(name: "bankTransactionUpdatedBy")
  ledgerTransactionCreated      LedgerTransaction[]    @relation(name: "ledgerTransactionCreatedBy")
  ledgerTransactionUpdated      LedgerTransaction[]    @relation(name: "ledgerTransactionUpdatedBy")
  ledgerTransactionCategorised  LedgerTransaction[]    @relation(name: "ledgerTransactionCategorisedBy")
  LedgerEntry                   LedgerEntry[]          @relation(name: "ledgerEntryUpdatedBy")
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt
  deletedAt                     DateTime?
  isDeleted                     Boolean                @default(false)

  @@index([email, status])
}

model Company {
  id                  String              @id @default(uuid())
  name                String
  website             String?
  industry            String?
  teamSize            String?
  revenue             String?
  countryId           String
  country             Country             @relation(name: "companyCountry", fields: [countryId], references: [id])
  reportingCurrencyId String
  reportingCurrency   Currency            @relation(name: "companyCurrency", fields: [reportingCurrencyId], references: [id])
  createdById         String
  createdBy           User                @relation(name: "companyCreator", fields: [createdById], references: [id])
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  users               UserCompany[]       @relation("companyUsers")
  coa                 Coa[]               @relation("companyCoa")
  bankAccounts        BankAccount[]       @relation("companyBankAccounts")
  contacts            Contact[]           @relation(name: "companyContacts")
  projects            Project[]           @relation(name: "companyProjects")
  ledgerTransactions  LedgerTransaction[] @relation(name: "companyLedgerTransactions")
  journalBatches      JournalBatch[]      @relation(name: "companyJournals")
  deletedAt           DateTime?
  isDeleted           Boolean             @default(false)

  @@index([name])
  @@index([countryId])
}

enum UserCompanyRole {
  ADMIN
  BOOKKEEPER
  VIEWER
}

model UserCompany {
  userId    String
  companyId String
  role      UserCompanyRole
  joinedAt  DateTime        @default(now())
  user      User            @relation("userCompanies", fields: [userId], references: [id])
  company   Company         @relation(name: "companyUsers", fields: [companyId], references: [id])

  @@id([userId, companyId])
  @@index([userId, companyId])
}

model Currency {
  id                        String         @id @default(uuid())
  code                      String         @unique
  name                      String         @unique
  symbol                    String
  companies                 Company[]      @relation("companyCurrency")
  coa                       Coa[]          @relation("coaCurrency")
  bankAccounts              BankAccount[]  @relation("bankAccountCurrency")
  exchangeRateBase          ExchangeRate[] @relation("baseCurrency")
  exchangeRateTarget        ExchangeRate[] @relation("targetCurrency")
  LedgerTransactionCurrency LedgerEntry[]  @relation(name: "ledgerTransactionCurrency")
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  isDeleted                 Boolean        @default(false)
  deletedAt                 DateTime?

  @@index([code])
}

model Country {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  phoneCode String
  flag      String?
  continent String?
  company   Company[] @relation("companyCountry")
  banks     Bank[]    @relation("bankCountry")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
}

model FinancialStatement {
  id             String           @id @default(uuid())
  statementKey   String           @unique
  usGaapLabel    String
  ifrsLabel      String
  defaultLabel   String
  accountElement AccountElement[] @relation("fsElement")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  isDeleted      Boolean          @default(false)
  deletedAt      DateTime?
}

enum DebitCredit {
  DEBIT
  CREDIT
}

model AccountElement {
  id                   String             @id @default(uuid())
  elementName          String
  defaultSide          DebitCredit
  parentId             String?
  parent               AccountElement?    @relation("parentChildRelation", fields: [parentId], references: [id]) // Self-relation
  children             AccountElement[]   @relation("parentChildRelation") // To define the reverse relation
  financialStatementId String
  financialStatement   FinancialStatement @relation(name: "fsElement", fields: [financialStatementId], references: [id])
  description          String?
  accountType          AccountType[]      @relation("typeElement")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  isDeleted            Boolean            @default(false)
  deletedAt            DateTime?
}

model AccountType {
  id               String          @id @default(uuid())
  typeName         String          @unique @db.VarChar(255)
  accountElementId String
  accountElement   AccountElement? @relation(name: "typeElement", fields: [accountElementId], references: [id])
  description      String?         @db.VarChar(255)
  coa              Coa[]           @relation("coaAccountType")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  isDeleted        Boolean         @default(false)
  deletedAt        DateTime?
}

model Coa {
  id             String         @id @default(uuid())
  accountCode    String?
  accountName    String
  description    String?
  accountTypeId  String
  accountType    AccountType    @relation(name: "coaAccountType", fields: [accountTypeId], references: [id])
  defaultSide    DebitCredit
  currencyId     String
  currency       Currency       @relation(name: "coaCurrency", fields: [currencyId], references: [id])
  companyId      String
  company        Company        @relation(name: "companyCoa", fields: [companyId], references: [id])
  isActive       Boolean        @default(true)
  balance        Decimal        @default(0)
  bankAccountId  String?        @unique
  bankAccount    BankAccount?   @relation(name: "bankCoaAccount")
  ledgerEntries  LedgerEntry[]  @relation("coaLedgerEntries")
  journalEntries JournalEntry[] @relation("journalEntries")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  isDeleted      Boolean        @default(false)
  deletedAt      DateTime?

  @@unique([accountName, companyId])
  @@unique([accountCode, companyId])
  @@index([companyId])
}

model CoaTemplate {
  id            String      @id @default(uuid())
  templateName  String
  accountCode   String
  accountName   String
  accountTypeId String
  defaultSide   DebitCredit
  description   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  isDeleted     Boolean     @default(false)
}

enum BankTransactionSource {
  FILE_IMPORT
  BANK_FEED
  MANUAL_ENTRY
}

enum BankAccountType {
  OTHER
  CREDIT_CARD
  DEBIT_CARD
  SAVINGS
  CHECKINGS_CURRENT
  UTILITY
}

model Bank {
  id           String        @id @default(uuid())
  name         String
  bankLogo     String?
  countryId    String
  country      Country       @relation(name: "bankCountry", fields: [countryId], references: [id])
  bankAccounts BankAccount[] @relation("bankStatements")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  isDeleted    Boolean       @default(false)
  deletedAt    DateTime?
}

model BankAccount {
  id                 String                 @id @default(uuid())
  bankId             String
  bank               Bank                   @relation(name: "bankStatements", fields: [bankId], references: [id])
  displayName        String
  bankAccountType    BankAccountType
  bankAccountNo      String
  bankBalance        Decimal                @default(0)
  lastReconciled     DateTime?
  currencyId         String
  currency           Currency               @relation(name: "bankAccountCurrency", fields: [currencyId], references: [id])
  companyId          String
  company            Company                @relation(name: "companyBankAccounts", fields: [companyId], references: [id])
  coaId              String                 @unique
  accountInCoa       Coa                    @relation("bankCoaAccount", fields: [coaId], references: [id])
  transactionBatches BankTransactionBatch[] @relation("transactionBatches")
  transactions       BankTransaction[]      @relation("transactionBankAccount")
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  isDeleted          Boolean                @default(false)
  deletedAt          DateTime?

  @@unique([companyId, bankAccountNo, bankId])
  @@index([companyId])
  @@index([currencyId])
}

model BankTransactionBatch {
  id               String                @id @default(uuid())
  importedDate     DateTime              @default(now())
  startDate        DateTime
  endDate          DateTime
  balanceBefore    Decimal
  balanceAfter     Decimal
  source           BankTransactionSource
  bankAccountId    String
  bankAccount      BankAccount           @relation(name: "transactionBatches", fields: [bankAccountId], references: [id])
  bankTransactions BankTransaction[]     @relation("batchTransactions")
  createdById      String
  updatedById      String?
  createdBy        User?                 @relation("createdByUser", fields: [createdById], references: [id])
  updatedBy        User?                 @relation("updatedByUser", fields: [updatedById], references: [id])
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  isDeleted        Boolean               @default(false)
  deletedAt        DateTime?

  @@index([bankAccountId])
  @@index([startDate, endDate])
}

enum CategorisationStatus {
  UNCATEGORISED
  AUTO_CATEGORISED
  CATEGORISED
}

model BankTransaction {
  id                     String                @id @default(uuid())
  date                   DateTime
  payee                  String?
  reference              String?
  description            String?
  additionalComments     String?
  transactionSide        DebitCredit?
  amount                 Decimal
  balance                Decimal
  absoluteAmount         Decimal               @default(0)
  defaultExchangeRate    Decimal
  isCategorised          Boolean               @default(false)
  categorisationStatus   CategorisationStatus  @default(UNCATEGORISED)
  categorisedAt          DateTime?
  categorisedById        String?
  categorisedBy          User?                 @relation("categorisedByUser", fields: [categorisedById], references: [id])
  bankAccountId          String
  bankAccount            BankAccount           @relation(name: "transactionBankAccount", fields: [bankAccountId], references: [id])
  bankTransactionBatchId String?
  bankTransactionBatch   BankTransactionBatch? @relation(name: "batchTransactions", fields: [bankTransactionBatchId], references: [id])
  ledgerTransactionId    String?
  ledgerTransaction      LedgerTransaction?    @relation(name: "ledgerBankTransactionMatch")
  createdById            String
  createdBy              User                  @relation(name: "bankTransactionCreatedBy", fields: [createdById], references: [id])
  updatedById            String?
  updatedBy              User?                 @relation(name: "bankTransactionUpdatedBy", fields: [updatedById], references: [id])
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  isDeleted              Boolean               @default(false)
  deletedAt              DateTime?

  @@index([bankTransactionBatchId])
  @@index([date])
  @@index([payee])
  @@index([amount])
  @@index([description])
  @@index([ledgerTransactionId])
}

