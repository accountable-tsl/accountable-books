// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}


model Role {
  id Int @id @default(autoincrement())
  name String @unique
  description String?
  users User[] @relation(name: "UserRole")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model User {
  id Int @id @default(autoincrement())
  firstname String
  lastname String?
  email String @unique
  password String
  phoneNumber String?
  status String @default("active")
  role Role @relation(name:"UserRole", fields: [roleId], references: [id])
  roleId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  profileImage String?
  companies UserCompany[] @relation(name: "UserCompanies")

  @@index([email, status])
}


model Company {
  id Int @id @default(autoincrement())
  name String
  website String?
  industry String?
  teamSize String?
  revenue String?
  country String
  reportingCurrency Currency @relation(fields: [reportingCurrencyId], references: [id])
  reportingCurrencyId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users UserCompany[] @relation("CompanyUsers")
  coa COA[] @relation("CompanyCOA")

  @@index([name])
  @@index([country])
}

model UserCompany {
  userId Int
  companyId Int
  role String
  joinedAt DateTime  @default(now())
  user User @relation("UserCompanies", fields: [userId], references: [id])
  company Company @relation(name: "CompanyUsers", fields: [companyId], references: [id])
  @@id([userId, companyId])
}

model Currency {
  id Int @id @default(autoincrement())
  code String
  name String
  symbol String
  companies Company[]

  @@index([code])
}

model CountryCode {
  id Int @id @default(autoincrement())
  code String @unique
  country String
}

enum AccountElement {
  asset
  liabilities
  equity
  revenue
  expense
}

enum AccountType {
  current_assets
  noncurrent_assets
  fixed_assets
  bank
  current_liabilities
  noncurrent_liabilities
  revenue
  income
  other_income
  finance_income
  cost_of_sales
  operating_expenses
  noncash_charges
  depreciation
  amortisation
  finance_costs
  tax_expense
  equity
}

enum FinancialStatement {
  balance_sheet
  income_statement
}

enum DebitCredit {
  debit
  credit
}

model COA {
  id Int @id @default(autoincrement())
  accountCode String?
  accountName String
  accountType AccountType
  element AccountElement
  financialStatement FinancialStatement
  debitOrCredit DebitCredit?
  sign String?
  description String?
  isActive Boolean @default(true)
  balance Decimal @default(0)
  companyId  Int
  company Company @relation(name: "CompanyCOA", fields: [companyId], references: [id])
  templateId Int?
  template COATemplate? @relation(name: "TemplateCOA", fields: [templateId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountName, companyId])
  @@unique([accountCode, companyId])
  @@index([companyId])
}

model COATemplate {
  id Int @id @default(autoincrement())
  templateName String
  coa COA[] @relation("TemplateCOA")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}