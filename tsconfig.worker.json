{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "module": "CommonJS",
    "target": "ES2020",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "strict": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/jobs/workers/**/*.ts"],
  "exclude": ["node_modules"]
}
