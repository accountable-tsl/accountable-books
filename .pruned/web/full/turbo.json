{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "codegen",
        "generate-env"
      ],
      "outputs": [
        "dist/**",
        "build/**",
        ".vite/**"
      ]
    },
    "bundle": {
      "dependsOn": [
        "validate-contracts"
      ],
      "inputs": [
        "packages/contracts/openapi.yaml",
        "packages/contracts/components/**",
        "packages/contracts/paths/**",
        "packages/contracts/.spectral.yaml"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "bundle-contracts": {
      "dependsOn": [
        "bundle"
      ],
      "outputs": []
    },
    "clean": {
      "outputs": []
    },
    "codegen": {
      "dependsOn": [
        "bundle-contracts"
      ],
      "outputs": [
        "src/generated/**"
      ]
    },
    "dev": {
      "cache": false,
      "dependsOn": [
        "generate-env",
        "codegen"
      ],
      "persistent": true
    },
    "generate-env": {
      "inputs": [
        "packages/utils/src/env/*"
      ],
      "outputs": [
        "apps/**/.env.local"
      ]
    },
    "lint": {
      "outputs": []
    },
    "migrate": {
      "cache": false
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "validate-contracts": {
      "outputs": []
    }
  },
  "ui": "tui"
}