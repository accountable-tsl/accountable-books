{
  "name": "accountable-api",
  "version": "1.0.0",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "seed": "tsx prisma/seed.ts",
    "dev": "tsx --watch index.ts",
    "dev:docker": "tsx --watch index.ts",
    "build": "tsc",
    "staging": "NODE_ENV=staging node dist/index.ts",
    "start": "NODE_ENV=production node dist/index.ts",
    "knex": "tsx ./node_modules/.bin/knex",
    "check-knex": "tsx -e \"import config from './knexfile'; console.log(config.development)\"",
    "migrate:make": "npm run knex -- migrate:make -x ts --knexfile knexfile.ts",
    "migrate:down": "knex migrate:down",
    "migrate:rollback": "knex migrate:rollback"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "glob": "^11.0.1",
    "ioredis": "^5.4.2",
    "knex": "^3.1.0",
    "lodash": "^4.17.21",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.14.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.16.2",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@prisma/client": "^6.5.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/knex": "^0.15.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.9",
    "i": "^0.3.7",
    "npm": "^10.9.2",
    "prettier": "^3.3.3",
    "prisma": "^6.5.0"
  }
}
