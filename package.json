{
  "name": "accountable-api",
  "version": "1.0.0",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev:local": "NODE_ENV=local tsx --watch index.ts",
    "dev:docker": "tsx DOCKER_MODE=true NODE_ENV=development --watch index.ts",
    "build": "tsc",
    "knex": "tsx node_modules/knex/bin/cli.js",
    "check-knex": "tsx -e \"import config from './knexfile.ts'; console.log(config.development)\"",
    "migrate": "npm run knex -- migrate:latest --env local --knexfile knexfile.ts",
    "migrate:staging": "NODE_ENV=staging npm run knex -- migrate:latest --env staging",
    "migrate:production": "NODE_ENV=production npm run knex -- migrate:latest --env production",
    "migrate:make": "npm run knex -- migrate:make -x ts --knexfile knexfile.ts",
    "migrate:down": "npm run knex -- migrate:down --knexfile knexfile.ts",
    "migrate:rollback": "npm run knex -- migrate:rollback --env local --knexfile knexfile.ts",
    "seed": "tsx prisma/seed.ts",
    "seed:docker": "DOCKER_MODE=true NODE_ENV=development tsx prisma/seed.ts",
    "seed:staging": "DOCKER_MODE=true NODE_ENV=staging tsx prisma/seed.ts",
    "start:worker": "tsx src/jobs/workers/email.worker.ts",
    "staging": "NODE_ENV=staging node dist/index.ts",
    "start": "NODE_ENV=production node dist/index.ts",
    "reset:db": "NODE_ENV=local tsx scripts/resetDatabase.ts"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@bull-board/api": "^6.9.0",
    "@bull-board/express": "^6.9.0",
    "@faker-js/faker": "^9.6.0",
    "@types/bcrypt": "^5.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.48.0",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dayjs": "^1.11.13",
    "decimal.js": "^10.5.0",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "glob": "^11.0.1",
    "ioredis": "^5.6.0",
    "knex": "^3.1.0",
    "lodash": "^4.17.21",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.0",
    "pg": "^8.14.1",
    "redis": "^4.7.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "typescript": "^5.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/knex": "^0.15.2",
    "@types/lodash": "^4.17.16",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.9",
    "@types/nodemailer": "^6.4.17",
    "i": "^0.3.7",
    "npm": "^10.9.2",
    "prettier": "^3.3.3",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3"
  }
}
