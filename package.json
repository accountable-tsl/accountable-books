{
  "name": "accountable-books",
  "version": "1.0.0",
  "description": "AI-native accounting platform for accounting firms - monorepo containing API, Web App, and ML Engine",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:core": "turbo run dev --parallel --filter !@accountable-books/web-payroll",
    "build": "turbo run build",
    "test": "turbo run test --concurrency=1",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "pnpm lint:fix && pnpm format",
    "generate-env": "pnpm -r -F \"@accountable-books/api\" -F \"@accountable-books/web\" run generate-env",
    "gen:pydantic": "pnpm -F @accountable-books/contracts run gen:pydantic && pnpm build",
    "gen:data": "pnpm -F @accountable-books/contracts run gen:data && pnpm build",
    "gen:contracts": "pnpm -F @accountable-books/contracts run gen:pydantic && pnpm -F @accountable-books/contracts run gen:data && pnpm build",
    "contracts": "pnpm gen:contracts",
    "clean": "turbo run clean",
    "prepare": "is-ci || husky",
    "worker": "pnpm -F @accountable-books/api run worker",
    "scheduler": "pnpm -F @accountable-books/api run scheduler"
  },
  "keywords": [],
  "author": "Accountable Techserve Inc.",
  "license": "ISC",
  "packageManager": "pnpm@11.3.0",
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@types/node": "^25.6.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "9.33.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.9.6",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.4",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.5.0"
  },
  "engines": {
    "node": ">=24.16.0",
    "pnpm": ">=11.0.0"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "apps/api/{migrations,seeds,knexfile.ts,scripts}/**/*.{ts,js}": [
      "cd apps/api && tsc -p tsconfig.tooling.json --noEmit"
    ],
    "**/*.{json,md,yaml,yml}": [
      "prettier --write"
    ],
    "apps/{api,web}/config/env-schema.ts": [
      "pnpm run generate-env"
    ]
  }
}
