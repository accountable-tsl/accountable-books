{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "newAccountType",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "key": {
      "type": "string",
      "maxLength": 64
    },
    "label": {
      "type": "string",
      "maxLength": 256
    },
    "description": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "account_element_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "report_code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(BS|IS)(\\.[A-Z]{3}){3,4}$"
    },
    "default_monetary": {
      "default": false,
      "type": "boolean"
    },
    "trainable": {
      "default": false,
      "type": "boolean"
    },
    "is_contra": {
      "default": false,
      "type": "boolean"
    },
    "is_postable_control": {
      "default": false,
      "type": "boolean"
    },
    "label_role": {
      "type": "string",
      "enum": ["semantic", "mechanical", "control", "fallback"]
    }
  },
  "required": [
    "id",
    "key",
    "label",
    "account_element_id",
    "report_code",
    "trainable",
    "label_role"
  ],
  "additionalProperties": false
}
