{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "companyContext",
  "type": "object",
  "properties": {
    "company_uuid": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": ["business", "individual", "accounting_firm"]
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "website": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "country_id": {
      "type": "string"
    },
    "country_code": {
      "type": "string"
    },
    "region_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "subregion_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "industry": {
      "type": "string"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accounting_basis": {
      "type": "string",
      "enum": ["modified_cash_basis", "modified_accrual_basis"]
    },
    "reporting_framework": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["ifrs", "us_gaap"]
        },
        {
          "type": "string",
          "const": "other"
        }
      ]
    },
    "reporting_currency_code": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3
    },
    "year_end_day": {
      "type": "number"
    },
    "year_end_month": {
      "type": "number"
    },
    "default_timezone": {
      "type": "string"
    },
    "company_settings_checksum": {
      "type": "string"
    },
    "coa_snapshot_version": {
      "type": "string"
    },
    "coa_snapshot_id": {
      "type": "string"
    },
    "coa_snapshot_checksum": {
      "type": "string"
    },
    "cached_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "company_uuid",
    "company_name",
    "type",
    "country_id",
    "country_code",
    "tags",
    "accounting_basis",
    "reporting_framework",
    "reporting_currency_code",
    "year_end_day",
    "year_end_month",
    "default_timezone",
    "company_settings_checksum",
    "coa_snapshot_version",
    "coa_snapshot_id",
    "cached_at"
  ],
  "additionalProperties": false
}
