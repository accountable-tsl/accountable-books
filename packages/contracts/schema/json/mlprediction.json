{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mlPrediction",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "rank": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "modelVersion": {
      "type": "string"
    },
    "overallExplanation": {
      "type": "string"
    },
    "overallExplanationTokens": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "anyOf": [
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        {
          "type": "null"
        }
      ]
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entryType": {
            "type": "string",
            "enum": ["debit", "credit"]
          },
          "coaId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "projectId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "amountNative": {
            "type": "number"
          },
          "currencyCode": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "isBankLeg": {
            "type": "boolean"
          },
          "splitType": {
            "type": "string",
            "enum": ["bank", "amount", "percentage", "remainder"]
          },
          "splitValue": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "explanation": {
            "type": "string"
          },
          "explanationTokens": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "metadata": {
            "anyOf": [
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "entryType",
          "coaId",
          "amountNative",
          "currencyCode",
          "splitType"
        ],
        "additionalProperties": false
      }
    },
    "netAmountNative": {
      "type": "number",
      "const": 0
    },
    "debitTotalNative": {
      "type": "number"
    },
    "creditTotalNative": {
      "type": "number"
    }
  },
  "required": [
    "id",
    "rank",
    "confidence",
    "modelVersion",
    "overallExplanation",
    "lines",
    "netAmountNative",
    "debitTotalNative",
    "creditTotalNative"
  ],
  "additionalProperties": false
}
