{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mlPredictedLine",
  "type": "object",
  "properties": {
    "entryType": {
      "type": "string",
      "enum": ["debit", "credit"]
    },
    "coaId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "projectId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "amountNative": {
      "type": "number"
    },
    "currencyCode": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "isBankLeg": {
      "type": "boolean"
    },
    "splitType": {
      "type": "string",
      "enum": ["bank", "amount", "percentage", "remainder"]
    },
    "splitValue": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "explanation": {
      "type": "string"
    },
    "explanationTokens": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "anyOf": [
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "entryType",
    "coaId",
    "amountNative",
    "currencyCode",
    "splitType"
  ],
  "additionalProperties": false
}
