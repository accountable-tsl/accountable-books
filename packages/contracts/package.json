    "gen:pydantic:no-clean": "tsx scripts/generate-pydantic.ts --no-clean",
    "build": "pnpm gen:pydantic"
  },
  "devDependencies": {
    "tsx": "^4.20.5"
  },
  "dependencies": {
    "zod": "^4.1.5"
  }
}
