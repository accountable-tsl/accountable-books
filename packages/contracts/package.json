{
  "name": "@accountable-books/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./schema/ts/index.js",
      "types": "./schema/ts/index.d.ts"
    },
    "./pydantic": {
      "import": "./schema/py/index.js",
      "types": "./schema/py/index.d.ts"
    }
  },
  "files": [
    "schema",
    "pyproject.toml"
