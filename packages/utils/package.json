{
  "name": "@accountable-books/utils",
  "version": "1.0.0",
  "description": "Shared utilities for the Accountable Books monorepo",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./env": {
      "types": "./src/env/index.ts",
      "import": "./dist/env/index.js",
      "default": "./dist/env/index.js"
    },
    "./timezone": {
      "types": "./src/timezone/index.ts",
      "import": "./dist/timezone/index.js",
      "default": "./dist/timezone/index.js"
    },
    "./firm-slugs": {
      "types": "./src/firm-slugs/index.ts",
      "import": "./dist/firm-slugs/index.js",
      "default": "./dist/firm-slugs/index.js"
    },
    "./telemetry/event-catalog": {
      "types": "./src/telemetry/event-catalog.ts",
      "import": "./dist/telemetry/event-catalog.js",
      "default": "./dist/telemetry/event-catalog.js"
    },
    "./telemetry/scrub": {
      "types": "./src/telemetry/scrub.ts",
      "import": "./dist/telemetry/scrub.js",
      "default": "./dist/telemetry/scrub.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "generate:timezones": "node ./scripts/generate-timezones.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@vvo/tzdb": "^6.198.0",
    "typescript": "workspace:*",
    "@types/node": "^25.0.6"
  },
  "dependencies": {}
}
