{
  "name": "@accountable-books/utils",
  "version": "1.0.0",
  "description": "Shared utilities for the Accountable Books monorepo",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./env": {
      "types": "./dist/env/index.d.ts",
      "import": "./dist/env/index.js"
    },
    "./env/types": {
      "types": "./dist/env/types.d.ts",
      "import": "./dist/env/types.js"
    },
    "./env/generator": {
      "types": "./dist/env/generator.d.ts",
      "import": "./dist/env/generator.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "workspace:*"
  },
  "dependencies": {}
}
