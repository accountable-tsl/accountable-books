#!/bin/sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Run lint-staged for changed files
pnpm lint-staged

# Validate and bundle contracts if they changed
if git diff --cached --name-only | grep -E "packages/contracts/.*\.yaml$"; then
  echo "📋 OpenAPI contracts changed, validating and bundling..."
  pnpm validate-contracts
  pnpm bundle-contracts
  # Add any generated files to the commit
  git add packages/contracts/dist/
fi

echo "✅ Pre-commit checks passed!"
