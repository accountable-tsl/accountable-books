#!/usr/bin/env sh
set -eu
export CI=1 TURBO_TELEMETRY_DISABLED=1 TURBO_TERM=plain

# pre-commit
echo "🔍 Running pre-commit checks..."

# Ensure essential environment files exist
echo "🔍 Validating environment files..."
if [ ! -f "apps/api/.env.example" ] || [ ! -f "apps/web/.env.example" ]; then
  echo "❌ Missing essential environment files. Run 'pnpm run generate-env' to generate them."
  exit 1
fi

make db-up

STAGED_FILES=$(git diff --cached --name-only)
if echo "$STAGED_FILES" | grep -qE '^packages/contracts/(accountable_contracts/(schema/source|data/source)/|scripts/generate-|package\.json)|^pnpm-lock\.yaml'; then
  echo "📦 Contract sources changed — syncing generated output..."
  pnpm -F @accountable-books/contracts build
else
  echo "ℹ Contract sources unchanged — skipping generation"
fi


# Run lint-staged for changed files (includes linting, formatting, contract validation)
pnpm lint-staged

# Quick typecheck
echo "🔍 Type checking..."
pnpm typecheck

# Run tests only for affected packages
echo "🧪 Running affected tests..."
pnpm --filter "{!@accountable-books/ml-engine}" test --affected -- --run

# Run ML engine tests separately (pytest doesn't support --affected)
echo "🧪 Running ML engine tests..."
pnpm --filter @accountable-books/ml-engine exec uv lock --check
pnpm --filter @accountable-books/ml-engine test:testmon

echo "✅ Pre-commit checks passed!"