{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "generate-env": {
      "dependsOn": ["^build"],
      "inputs": ["packages/utils/src/env/*"],
      "outputs": ["apps/api/.env.**", "apps/web/.env.**"]
    },

    "validate-contracts": {
      "outputs": []
    },

    "bundle": {
      "dependsOn": ["validate-contracts"],
      "inputs": [
        "packages/contracts/openapi.yaml",
        "packages/contracts/components/**",
        "packages/contracts/paths/**",
        "packages/contracts/.spectral.yaml"
      ],
      "outputs": ["dist/**"]
    },

    "bundle-contracts": {
      "dependsOn": ["bundle"],
      "outputs": []
    },

    "codegen": {
      "dependsOn": ["bundle-contracts"],
      "outputs": ["src/generated/**"]
    },

    "build": {
      "dependsOn": ["^build", "codegen", "generate-env"],
      "outputs": ["dist/**", "build/**", ".vite/**"]
    },

    "typecheck": {
      "dependsOn": ["^typecheck"]
    },

    "lint": {
      "outputs": []
    },

    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },

    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["generate-env", "codegen"]
    },

    "migrate": {
      "cache": false
    },

    "clean": {
      "outputs": []
    }
  }
}
