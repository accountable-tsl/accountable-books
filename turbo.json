{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "validate-contracts": {
      "outputs": []
    },

    "bundle": {
      "dependsOn": ["validate-contracts"],
      "inputs": [
        "packages/contracts/openapi.yaml",
        "packages/contracts/components/**",
        "packages/contracts/paths/**"
      ],
      "outputs": ["dist/**"]
    },

    "bundle-contracts": {
      "dependsOn": ["bundle"],
      "outputs": []
    },

    "codegen": {
      "dependsOn": ["bundle-contracts"],
      "outputs": ["src/generated/**"]
    },

    "build": {
      "dependsOn": ["^build", "codegen"],
      "outputs": ["dist/**", "build/**", ".vite/**"]
    },

    "typecheck": {
      "dependsOn": ["^typecheck"]
    },

    "lint": {
      "outputs": []
    },

    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**", "reports/**"]
    },

    "dev": {
      "cache": false,
      "persistent": true
    },

    "migrate": {
      "cache": false
    },

    "clean": {
      "outputs": []
    }
  }
}
