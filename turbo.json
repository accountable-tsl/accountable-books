{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "generate-env": {
      "dependsOn": ["^build"],
      "inputs": ["packages/utils/src/env/*"],
      "outputs": ["apps/api/.env.**", "apps/web/.env.**"]
    },

    "build": {
      "dependsOn": ["^build", "generate-env"],
      "outputs": ["dist/**", "build/**", ".vite/**"]
    },

    "typecheck": {
      "dependsOn": ["^typecheck"]
    },

    "lint": {
      "outputs": []
    },

    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },

    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["generate-env"]
    },

    "migrate": {
      "cache": false
    },

    "clean": {
      "outputs": []
    }
  }
}
