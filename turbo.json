{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "codegen": {
      "outputs": ["packages/contracts/generated/**"]
    },

    "build": {
      "dependsOn": ["^build", "codegen"],
      "outputs": ["dist/**", "build/**", ".vite/**"]
    },

    "typecheck": {
      "dependsOn": ["^typecheck"]
    },

    "lint": {
      "outputs": []
    },

    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**", "reports/**"]
    },

    "dev": {
      "cache": false,
      "persistent": true
    },

    "migrate": {
      "cache": false
    }
  }
}
