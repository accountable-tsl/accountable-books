{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "generate-env": {
      "dependsOn": ["^build"],
      "inputs": ["packages/utils/src/env/*"],
      "cache": false
    },

    "build": {
      "dependsOn": ["^build", "generate-env"],
      "outputs": [
        "dist/**",
        "build/**",
        ".vite/**",
        "generated/**",
        "accountable_contracts/**/*.js",
        "accountable_contracts/**/*.js.map",
        "accountable_contracts/**/*.d.ts",
        "accountable_contracts/**/*.d.ts.map",
        "accountable_contracts/data/index.ts",
        "accountable_contracts/data/__init__.py",
        "accountable_contracts/data/generated/**",
        "accountable_contracts/schema/py/**",
        "!accountable_contracts/**/__pycache__/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },

    "lint": {
      "outputs": []
    },

    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },

    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["generate-env"]
    },

    "migrate": {
      "cache": false
    },

    "clean": {
      "outputs": []
    }
  }
}
