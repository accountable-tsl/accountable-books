# Multi-stage build for Web staging
FROM node:24-alpine AS base
RUN npm install -g pnpm@10.15.1
WORKDIR /app

# Prune stage - only get what @accountable-books/web needs
FROM base AS pruner
COPY . .
RUN npm install -g turbo@2.5.6
RUN turbo prune @accountable-books/web --docker

# Install dependencies stage
FROM base AS deps
# Copy pruned workspace
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml

# Install dependencies
RUN pnpm install --frozen-lockfile

# Build stage - build shared packages that web depends on
FROM base AS builder
# Install turbo for the build
RUN npm install -g turbo@2.5.6

# Copy dependencies
COPY --from=deps /app/ .

# Copy pruned source code
COPY --from=pruner /app/out/full/ .

# Copy root config files that turbo prune doesn't include
COPY tsconfig.base.json ./
COPY turbo.json ./

# Build shared packages AND web app for production (like Vercel)
RUN turbo build --filter=@accountable-books/web

# Runtime stage - serve built static files with nginx (like Vercel)
FROM nginx:alpine AS runtime
# Install wget for health checks
RUN apk add --no-cache wget

# Copy built app to nginx
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# Copy nginx configuration for SPA routing
COPY apps/web/infra/nginx/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]