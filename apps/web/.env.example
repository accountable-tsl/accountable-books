# =============================================================================
# Environment Configuration - LOCAL
# =============================================================================
# Auto-generated from environment schema. Do not edit manually.
# Run 'pnpm run generate-env' to regenerate this file.

# Backend API URL (must start with VITE_ for Vite)
VITE_BACKEND_URL=http://api.lvh.me:5000

# Base domain for the application
VITE_BASE_DOMAIN=lvh.me

# Mono bank connection service public key
VITE_MONO_PUBLIC_KEY=

# Sentry error tracking DSN for frontend
VITE_SENTRY_DSN=

# PostHog project API key for browser SDK
VITE_POSTHOG_KEY=

# PostHog ingestion host (EU cloud)
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Enable PostHog product analytics in browser
VITE_POSTHOG_ENABLED=false

# Master switch for browser telemetry (PostHog)
VITE_TELEMETRY_ENABLED=false

# Enable development tools and debugging features
VITE_ENABLE_DEV_TOOLS=true

# API request timeout in milliseconds
VITE_API_TIMEOUT=10000

# Enable the app-level AI runtime + UI shell
VITE_AI_ENABLED=true

# Comma-separated list of AI domains to disable in the UI shell
VITE_AI_DISABLED_DOMAINS=

# Comma-separated list of AI capability IDs to disable in the UI shell
VITE_AI_DISABLED_CAPABILITIES=

# Optional comma-separated allowlist of AI domains. When set, only these domains are enabled in the UI shell.
VITE_AI_ENABLED_DOMAINS=

# Optional comma-separated allowlist of AI capability IDs. When set, only these capabilities are enabled in the UI shell.
VITE_AI_ENABLED_CAPABILITIES=
