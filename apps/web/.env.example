# =============================================================================
# Environment Configuration - LOCAL
# =============================================================================
# Auto-generated from environment schema. Do not edit manually.
# Run 'pnpm run generate-env' to regenerate this file.

# Backend API URL (must start with VITE_ for Vite)
VITE_BACKEND_URL=http://api.lvh.me:5000

# Base domain for the application
VITE_BASE_DOMAIN=lvh.me

# Mono bank connection service public key
VITE_MONO_PUBLIC_KEY=

# Mixpanel analytics token for frontend tracking
VITE_MIXPANEL_TOKEN=

# Sentry error tracking DSN for frontend
VITE_SENTRY_DSN=

# Enable development tools and debugging features
VITE_ENABLE_DEV_TOOLS=true

# API request timeout in milliseconds
VITE_API_TIMEOUT=10000
