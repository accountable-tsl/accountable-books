{
  "version": "fmap_a_1.0",
  "model_name": "global_intent_classifier",
  "description": "Initial feature mapping for Model A (TF-IDF heuristic)",
  "created_at": "2024-11-27",
  "features": {
    "text_embedding": {
      "type": "embedding",
      "dimension": 384,
      "source_fields": [
        "normalized.description",
        "normalized.contact_name",
        "raw.reference",
        "normalized.global_contact_name",
        "normalized.global_contact_category_hints",
        "signals.notes",
        "context.industry"
      ]
    },
    "numeric_features": ["raw.amount"],
    "temporal_features": [
      "day_of_week",
      "calendar_month",
      "calendar_quarter",
      "fiscal_month",
      "fiscal_quarter"
    ],
    "categorical_features": [
      "raw.currency_code",
      "context.country_code",
      "context.reporting_currency_code",
      "normalized.contact_match_confidence",
      "normalized.contact_type"
    ],
    "binary_flags": [
      "signals.likely_trf_btw_accounts",
      "signals.likely_split",
      "signals.requires_vat_check",
      "signals.requires_fx_review"
    ]
  }
}
