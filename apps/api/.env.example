# =============================================================================
# Environment Configuration - LOCAL
# =============================================================================
# Auto-generated from environment schema. Do not edit manually.
# Run 'pnpm run generate-env' to regenerate this file.

# Application environment
NODE_ENV=local

# Server port
PORT=5000

# Base domain for the application
BASE_DOMAIN=lvh.me

# Backend API URL
BACKEND_URL=http://api.lvh.me:5000

# Frontend application URL
FRONTEND_URL=http://app.lvh.me:5173

# Domain for setting cookies (e.g. .lvh.me or localhost)
COOKIE_DOMAIN=.lvh.me

# Database host
DB_HOST=localhost

# Database port
DB_PORT=5433

# Database name
POSTGRES_DB=accountable_books

# Database username
POSTGRES_USER=user

# Database password
POSTGRES_PASSWORD=your_postgres_password_here

# Complete PostgreSQL connection string
DATABASE_URL=your_database_url_here

# Complete PostgreSQL connection string
DATABASE_URL_NOPOOL=your_database_url_nopool_here

# Redis connection URL
REDIS_URL=your_redis_url_here

# Redis password
REDIS_PASSWORD=your_redis_password_here

# Local Redis connection URL
LOCAL_STAGING_REDIS_URL=your_local_staging_redis_url_here

# ML Engine API URL for transaction categorization
ML_ENGINE_URL=http://localhost:8000

# CSRF protection secret
CSRF_SECRET=your_csrf_secret_here

# JWT access token secret (min 32 chars)
JWT_ACCESS_SECRET=your_jwt_access_secret_here

# JWT refresh token secret (min 32 chars)
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Email service provider
EMAIL_PROVIDER=ethereal

# Postmark API key for sending emails
POSTMARK_API_KEY=your_postmark_api_key_here

# Default sender email address
EMAIL_FROM=email@example.com

# Ethereal email for testing
ETHEREAL_EMAIL=

# Ethereal email password for testing
ETHEREAL_PASSWORD=your_ethereal_password_here

# Slack app signing secret
SLACK_SIGNING_SECRET=your_slack_signing_secret_here

# Slack bot token
SLACK_BOT_TOKEN=your_slack_bot_token_here

# Default Slack channel for notifications
SLACK_CHANNEL=dev

# Sentry error tracking DSN
SENTRY_DSN=your_sentry_dsn_here

# Sentry release version
SENTRY_RELEASE=0.0.0

# PostHog server-side project API key
POSTHOG_API_KEY=your_posthog_api_key_here

# PostHog ingestion host (EU cloud)
POSTHOG_HOST=https://eu.i.posthog.com

# Enable PostHog product analytics (server-side)
POSTHOG_ENABLED=false

# Master switch for non-Sentry telemetry (PostHog, OTel traces)
TELEMETRY_ENABLED=false

# Cloudflare R2 API token
R2_TOKEN=your_r2_token_here

# Cloudflare R2 access key ID
R2_ACCESS_KEY_ID=your_r2_access_key_id_here

# Cloudflare R2 secret access key
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here

# Cloudflare R2 endpoint URL
R2_ENDPOINT=your_r2_endpoint_here

# Cloudflare R2 bucket name for logos
R2_LOGOS_BUCKET_NAME=logos

# Cloudflare R2 domain for logos
R2_LOGOS_DOMAIN=https://logos.getaccountable.com

# Cloudflare R2 bucket name for transaction files
R2_TRANSACTION_FILES_BUCKET_NAME=transaction-files

# Main platform company UUID
PLATFORM_COMPANY_ID=00000000-0000-0000-0000-000000000000

# Platform company legal name
PLATFORM_COMPANY_NAME=Accountable Company Name

# Platform company short identifier
PLATFORM_COMPANY_SHORT_CODE=YOUR_CODE

# Platform accounting firm UUID
PLATFORM_ACCOUNTING_FIRM_ID=00000000-0000-0000-0000-000000000000

# Platform company logo URL
PLATFORM_COMPANY_LOGO_URL=

# Confirm platform setup
CONFIRM_PLATFORM_SETUP=

# Test admin user ID (UUID)
TEST_ADMIN_ID=00000000-0000-0000-0000-000000000000

# Test admin user email
TEST_ADMIN_EMAIL=email@example.com

# Test admin user first name
TEST_ADMIN_FIRSTNAME=Admin

# Test admin user last name
TEST_ADMIN_LASTNAME=User

# Test admin user password
TEST_ADMIN_PASSWORD=your_test_admin_password_here

# Production admin user ID (UUID)
ADMIN_ID=

# Production admin user email
ADMIN_EMAIL=

# Production admin user first name
ADMIN_FIRSTNAME=System

# Production admin user last name
ADMIN_LASTNAME=Administrator

# Production admin user password
ADMIN_PASSWORD=your_admin_password_here

# Whether to seed database with demo data
SEED_DB=false

# Enable AI endpoints (app-level)
AI_ENABLED=false

# OpenAI API key used by the AI orchestrator
OPENAI_API_KEY=your_openai_api_key_here

# Default OpenAI model name for chat (capabilities may override)
OPENAI_MODEL=gpt-4o-mini

# Bull Board admin username
BULLBOARD_USER=admin

# Bull Board admin password
BULLBOARD_PASSWORD=your_bullboard_password_here

# Name feed providers will display
FEED_DISPLAY_NAME=Accountable

# Mono secret key
MONO_SECRET_KEY=your_mono_secret_key_here

# Plaid client ID
PLAID_CLIENT_ID=your_plaid_client_id_here

# Plaid secret
PLAID_SECRET=your_plaid_secret_here

# Plaid country codes (comma-separated)
PLAID_COUNTRY_CODES=YOUR_CODE

# Plaid products (comma-separated)
PLAID_PRODUCTS=auth,transactions

# Plaid environment
PLAID_ENV=sandbox

# Plaid API version
PLAID_VERSION=2020-09-14

# Plaid redirect URI
PLAID_REDIRECT_URI=

# Plaid webhook verification secret (optional - enables webhook signature verification)
PLAID_WEBHOOK_SECRET=your_plaid_webhook_secret_here

# Force webhook verification even in development mode
ENABLE_WEBHOOK_VERIFICATION=false

# Number of concurrent email jobs to process
EMAIL_WORKER_CONCURRENCY=5

# Number of concurrent transaction sync connections to process
TRANSACTION_SYNC_CONCURRENCY=3

# Cron pattern for transaction sync scheduler (e.g., "0 2 * * *" for daily at 2 AM UTC, "0 */6 * * *" for every 6 hours)
TRANSACTION_SYNC_CRON=0 2 * * *

# Enable Redis command usage monitoring and logging
ENABLE_REDIS_MONITORING=false

# Active AES-256 key id (0..255)
APP_ENC_KEY_ID=your_app_enc_key_id_here

# Comma-separated keys as id:base64(32B)
APP_ENC_KEYS=your_app_enc_keys_here
