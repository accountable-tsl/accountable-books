# =============================================================================
# Environment Configuration - LOCAL
# =============================================================================
# Auto-generated from environment schema. Do not edit manually.
# Run 'pnpm run generate-env' to regenerate this file.

# Application environment
NODE_ENV=local

# Server port
PORT=5000

# Base domain for the application
BASE_DOMAIN=localhost

# Backend API URL
BACKEND_URL=http://localhost:5000

# Frontend application URL
FRONTEND_URL=http://localhost:5173

# Domain for setting cookies
COOKIE_DOMAIN=localhost

# Database host
DB_HOST=localhost

# Database port
DB_PORT=5433

# Database name
DB_NAME=accountable_books

# Database username
DB_USER=user

# Database password
DB_PASSWORD=your_db_password_here

# Complete PostgreSQL connection string
DATABASE_URL=your_database_url_here

# Redis connection URL
REDIS_URL=redis://localhost:6380

# CSRF protection secret
CSRF_SECRET=your_csrf_secret_here

# JWT access token secret (min 32 chars)
JWT_ACCESS_SECRET=your_jwt_access_secret_here

# JWT refresh token secret (min 32 chars)
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Email service provider
EMAIL_PROVIDER=postmark

# Postmark API key for sending emails
POSTMARK_API_KEY=your_postmark_api_key_here

# Default sender email address
EMAIL_FROM=dev@accountable.local

# Ethereal email for testing
ETHEREAL_EMAIL=

# Ethereal email password for testing
ETHEREAL_PASSWORD=your_ethereal_password_here

# Slack app signing secret
SLACK_SIGNING_SECRET=your_slack_signing_secret_here

# Slack bot token
SLACK_BOT_TOKEN=your_slack_bot_token_here

# Default Slack channel for notifications
SLACK_CHANNEL=dev

# Mixpanel analytics token
MIXPANEL_TOKEN=

# Sentry error tracking DSN
SENTRY_DSN=

# Cloudflare R2 API token
R2_TOKEN=your_r2_token_here

# Cloudflare R2 access key ID
R2_ACCESS_KEY_ID=your_r2_access_key_id_here

# Cloudflare R2 secret access key
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here

# Cloudflare R2 endpoint URL
R2_ENDPOINT=

# Cloudflare R2 bucket name for logos
R2_LOGOS_BUCKET_NAME=logos

# Cloudflare R2 domain for logos
R2_LOGOS_DOMAIN=

# Main platform company UUID
PLATFORM_COMPANY_ID=a494b675-fedd-455c-ab6d-00ffdff9a047

# Platform company legal name
PLATFORM_COMPANY_NAME=Accountable Techserve Ltd

# Platform company short identifier
PLATFORM_COMPANY_SHORT_CODE=accX

# Platform accounting firm UUID
PLATFORM_ACCOUNTING_FIRM_ID=fb60dc2d-732e-4bf6-9f0c-74577354e816

# Test admin user ID (UUID)
TEST_ADMIN_ID=018f7e5e-0000-0000-0000-000000000001

# Test admin user email
TEST_ADMIN_EMAIL=support@getaccountable.com

# Test admin user first name
TEST_ADMIN_FIRSTNAME=Admin

# Test admin user last name
TEST_ADMIN_LASTNAME=User

# Test admin user password
TEST_ADMIN_PASSWORD=your_test_admin_password_here

# Production admin user ID (UUID)
ADMIN_ID=

# Production admin user email
ADMIN_EMAIL=

# Production admin user first name
ADMIN_FIRSTNAME=

# Production admin user last name
ADMIN_LASTNAME=

# Production admin user password
ADMIN_PASSWORD=your_admin_password_here

# Whether to seed database with demo data
SEED_DB=false

# Bull Board admin username
BULLBOARD_USER=admin

# Bull Board admin password
BULLBOARD_PASSWORD=your_bullboard_password_here
