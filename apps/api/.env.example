# =============================================================================
# ACCOUNTABLE BOOKS API - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.local and update values as needed
# Most defaults work out-of-the-box for local development

# -----------------------------------------------------------------------------
# RUNTIME CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=local
PORT=5000
BASE_DOMAIN=localhost
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
COOKIE_DOMAIN=localhost

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (Docker defaults - should work out-of-the-box)
# -----------------------------------------------------------------------------
# These match the docker-compose.dev.yml database service
DB_HOST=localhost
DB_PORT=5433
DB_NAME=accountable_books
DB_USER=user
DB_PASSWORD=password
DATABASE_URL=postgres://user:password@localhost:5433/accountable_books

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION (Docker defaults - should work out-of-the-box)  
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6380

# -----------------------------------------------------------------------------
# SECURITY CONFIGURATION
# -----------------------------------------------------------------------------
# ⚠️  REQUIRED: Generate secure secrets for production
# For local development, these defaults are sufficient
CSRF_SECRET=dev-csrf-secret-change-in-production
JWT_ACCESS_SECRET=dev-jwt-access-secret-change-in-production-min-32-chars
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-change-in-production-min-32-chars

# -----------------------------------------------------------------------------
# OPTIONAL: EMAIL CONFIGURATION
# -----------------------------------------------------------------------------
# Leave empty for development - emails will be logged to console
EMAIL_PROVIDER=postmark
POSTMARK_API_KEY=
EMAIL_FROM=dev@accountable.local
ETHEREAL_EMAIL=
ETHEREAL_PASSWORD=

# -----------------------------------------------------------------------------
# OPTIONAL: SLACK NOTIFICATIONS
# -----------------------------------------------------------------------------
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_CHANNEL=dev

# -----------------------------------------------------------------------------
# OPTIONAL: ANALYTICS & MONITORING
# -----------------------------------------------------------------------------
MIXPANEL_TOKEN=
SENTRY_DSN=

# -----------------------------------------------------------------------------
# OPTIONAL: DEVELOPMENT FEATURES
# -----------------------------------------------------------------------------
# Set to true to seed database with demo data
SEED_DB=false

# Bull Board admin credentials (for queue monitoring at /admin/queues)
BULLBOARD_USER=admin
BULLBOARD_PASSWORD=secret
