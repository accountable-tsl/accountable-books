# Runtime
NODE_ENV=local
PORT=5000
BACKEND_URL=http://api.lvh.me:5000
FRONTEND_URL=http://app.lvh.me:5173
BASE_DOMAIN=lvh.me
COOKIE_DOMAIN=.lvh.me

# Datastores
DATABASE_URL=postgres://temi:@localhost:5432/accountable_local
REDIS_URL=redis://localhost:6379

# Security
CSRF_SECRET=replace-me
JWT_ACCESS_SECRET=replace-me-long
JWT_REFRESH_SECRET=replace-me-long

# Email / Messaging
EMAIL_PROVIDER=postmark
POSTMARK_API_KEY=
EMAIL_FROM=support@getaccountable.com
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_CHANNEL=sandbox

# Analytics
MIXPANEL_TOKEN=

# Feature flags
SEED_DB=false

# Sentry
SENTRY_DSN=
