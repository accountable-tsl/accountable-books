# Create a .env.docker file and fill in the values below
DATABASE_URL=postgresql://postgres:1412@db:5432/accountable_db
PORT=5000
BACKEND_URL=yourbackendurlwithoutport #example:http://localhost
FRONTEND_URL=yourfrontendurlwithport #example:http://localhost:3000
DB_HOST=db #This should be db per docker-compose.dev.yml setup. Only change this if you change that
DB_PORT=5432
DB_NAME=database_name
DB_USER=database_user
DB_PASSWORD=yourpassword
NODE_ENV=development
SEED_DB=true


# Create a .env.db file and fill in the values below (Should match data above)
POSTGRES_DB=database_name
POSTGRES_USER=database_user
POSTGRES_PASSWORD=yourpassword
POSTGRES_PORT=5432