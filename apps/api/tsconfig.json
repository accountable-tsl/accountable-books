{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "types": ["node"],
    "sourceMap": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src", "config/env-loader.ts", "src/db/knex.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "vitest.config.ts",
    "migrations",
    "seeds",
    "scripts"
  ]
}
