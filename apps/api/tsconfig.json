{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "baseUrl": ".",
    "types": ["node"],
    "sourceMap": true,
    "inlineSources": true,
    "sourceRoot": "/",
    "verbatimModuleSyntax": true,
    "declaration": false,
    "composite": false
  },
  "include": ["src", "config/env-loader.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "vitest.config.ts",
    "knexfile.cjs",
    "migrations",
    "seeds",
    "scripts"
  ]
}
