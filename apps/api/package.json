{
  "name": "@accountable-books/api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=local tsx watch src/server.ts",
    "dev:staging": "NODE_ENV=staging tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && cpy \"src/public/**\" dist/public",
    "start": "NODE_ENV=production node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:all": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tooling.json --noEmit",
    "lint": "eslint .",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate-env": "tsx config/env-schema.ts",
    "knex": "tsx node_modules/knex/bin/cli.js",
    "migrate:make": "pnpm run knex migrate:make -x ts --knexfile knexfile.ts",
    "migrate": "pnpm run knex migrate:latest --env local --knexfile knexfile.ts",
    "migrate:test": "NODE_ENV=test pnpm run knex migrate:latest --env test --knexfile knexfile.ts",
    "migrate:staging": "NODE_ENV=staging LOCAL_STAGING=true pnpm run knex migrate:latest --env staging --knexfile knexfile.ts",
    "migrate:staging:remote": "NODE_ENV=staging pnpm run knex migrate:latest --env staging --knexfile knexfile.ts",
    "rollback": "pnpm run knex migrate:rollback --env local --knexfile knexfile.ts",
    "rollback:staging": "NODE_ENV=staging LOCAL_STAGING=true pnpm run knex migrate:rollback --env staging --knexfile knexfile.ts",
    "rollback:staging:remote": "NODE_ENV=staging pnpm run knex migrate:rollback --env staging --knexfile knexfile.ts",
    "db:reset": "NODE_ENV=local tsx scripts/resetDatabase.ts && pnpm run migrate && pnpm run demo:apply",
    "demo": "tsx seeds/demo/cli.ts",
    "demo:apply": "pnpm run demo apply --all",
    "demo:apply:test": "NODE_ENV=test pnpm run demo apply --all",
    "demo:apply:staging:local": "NODE_ENV=staging LOCAL_STAGING=true pnpm run demo apply",
    "demo:apply:staging:remote": "NODE_ENV=staging pnpm run demo apply --all",
    "demo:reverse": "tsx seeds/demo/cli.ts reverse",
    "demo:reset": "tsx seeds/demo/cli.ts reset",
    "demo:status": "tsx seeds/demo/cli.ts status",
    "worker": "tsx src/worker.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "sentry:sourcemaps": "sentry-cli releases files \"$SENTRY_RELEASE\" upload-sourcemaps dist --rewrite && sentry-cli releases finalize \"$SENTRY_RELEASE\"",
    "slack": "tsx src/features/communications/slack.service.ts"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@accountable-books/api-types": "workspace:*",
    "@accountable-books/utils": "workspace:*",
    "@aws-sdk/client-s3": "^3.817.0",
    "@aws-sdk/s3-request-presigner": "^3.32.0",
    "@bull-board/api": "^6.9.0",
    "@bull-board/express": "^6.9.0",
    "@sentry/node": "^9.12.0",
    "@sentry/profiling-node": "^9.12.0",
    "@slack/bolt": "^4.3.0",
    "@zodios/core": "^10.9.6",
    "axios": "^1.7.9",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.48.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf-csrf": "^4.0.3",
    "csv-parser": "^3.0.0",
    "dayjs": "^1.11.13",
    "decimal.js": "^10.5.0",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "mixpanel": "^0.18.1",
    "multer": "^2.0.1",
    "nodemailer": "^6.10.0",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "plaid": "^38.0.0",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.7.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.7.0",
    "@sentry/cli": "^2.43.0",
    "@slack/types": "^2.14.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/knex": "^0.15.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.9",
    "@types/nodemailer": "^6.4.17",
    "@types/rate-limit-redis": "^1.7.4",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "cpy-cli": "^6.0.0",
    "sqlite3": "5.1.6",
    "tsx": "^4.19.3"
  }
}
