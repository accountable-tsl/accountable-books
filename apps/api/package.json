{
  "name": "@accountable-books/api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=local tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && cpy \"src/public/**\" dist/public",
    "start": "NODE_ENV=production node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate-env": "tsx scripts/generate-env.ts",
    "knex": "tsx node_modules/knex/bin/cli.js",
    "migrate:make": "pnpm run knex migrate:make -x ts --knexfile knexfile.ts",
    "migrate:local": "pnpm run knex migrate:latest --env local --knexfile knexfile.ts",
    "migrate:rollback": "pnpm run knex migrate:rollback --step=1 --env local --knexfile knexfile.ts",
    "reset:db": "NODE_ENV=local tsx scripts/resetDatabase.ts && pnpm run migrate:local && pnpm run seed:demo",
    "seed:demo": "tsx seeds/demo/index.ts",
    "demo": "tsx seeds-dex/cli.ts",
    "demo:apply": "tsx seeds-dex/cli.ts apply",
    "demo:add": "tsx seeds-dex/cli.ts add",
    "demo:purge": "tsx seeds-dex/cli.ts purge",
    "demo:list": "tsx seeds-dex/cli.ts list",
    "demo:status": "tsx seeds-dex/cli.ts status",
    "seed:demo:all": "tsx seeds-cld/cli.ts setup all",
    "seed:demo:country": "tsx seeds-cld/cli.ts setup country",
    "seed:demo:type": "tsx seeds-cld/cli.ts setup type",
    "seed:demo:company": "tsx seeds-cld/cli.ts setup company",
    "seed:demo:add": "tsx seeds-cld/cli.ts add",
    "seed:demo:clean": "tsx seeds-cld/cli.ts clean",
    "seed:demo:status": "tsx seeds-cld/cli.ts status",
    "seed:demo:list": "tsx seeds-cld/cli.ts list",
    "seed:demo:inspect": "tsx seeds-cld/cli.ts inspect",
    "seed:demo:history": "tsx seeds-cld/cli.ts history",
    "start:worker": "tsx src/jobs/workers/email.worker.ts",
    "sentry:sourcemaps": "sentry-cli releases files \"$SENTRY_RELEASE\" upload-sourcemaps dist --rewrite && sentry-cli releases finalize \"$SENTRY_RELEASE\"",
    "slack": "tsx src/features/communications/slack.service.ts"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.817.0",
    "@aws-sdk/s3-request-presigner": "^3.32.0",
    "@bull-board/api": "^6.9.0",
    "@bull-board/express": "^6.9.0",
    "@sentry/node": "^9.12.0",
    "@sentry/profiling-node": "^9.12.0",
    "@slack/bolt": "^4.3.0",
    "axios": "^1.7.9",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.48.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf-csrf": "^4.0.3",
    "csv-parser": "^3.0.0",
    "dayjs": "^1.11.13",
    "decimal.js": "^10.5.0",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "mixpanel": "^0.18.1",
    "multer": "^2.0.1",
    "nodemailer": "^6.10.0",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.7.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.2",
    "@accountable-books/api-types": "workspace:*",
    "@accountable-books/utils": "workspace:*"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.7.0",
    "@sentry/cli": "^2.43.0",
    "@slack/types": "^2.14.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/knex": "^0.15.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.9",
    "@types/nodemailer": "^6.4.17",
    "@types/rate-limit-redis": "^1.7.4",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "cpy-cli": "^6.0.0",
    "tsx": "^4.19.3"
  }
}
