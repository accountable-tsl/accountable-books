{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,

    "paths": {
      "@prisma/client": ["./prisma/client"]
    },

    "sourceMap": true,
    "inlineSources": true,

    // Set `sourceRoot` to  "/" to strip the build path prefix
    // from generated source code references.
    // This improves issue grouping in Sentry.
    "sourceRoot": "/"
  },
  "include": [
    "**/*.ts",
    "custom.d.ts",
    "knexfile.ts",
    "types/**/*",
    "src/**/*"
  ],
  "exclude": ["node_modules"]
}
