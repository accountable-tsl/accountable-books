{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "paths": {
      "@prisma/client": ["./prisma/client"]
    }
  },
  "include": [
    "**/*.ts",
    "custom.d.ts",
    "knexfile.ts",
    "types/**/*",
    "src/**/*"
  ],
  "exclude": ["node_modules"]
}
