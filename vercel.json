{
  "buildCommand": "pnpm --filter @accountable-books/web build",
  "installCommand": "pnpm install",
  "framework": "vite",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "feature/*": false,
      "fix/*": false,
      "develop": false,
      "staging": true
    }
  }
}
