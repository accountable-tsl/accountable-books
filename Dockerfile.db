# FROM postgres:17

# RUN apt-get update && apt-get install -y curl

# RUN apt-get -y install postgresql-17-cron

# RUN echo "shared_preload_libraries = 'pg_cron'" >> /docker-entrypoint-initdb.d/pg_cron.conf
# RUN echo "cron.database_name = '${POSTGRES_DB}'" >> /docker-entrypoint-initdb.d/pg_cron.conf

FROM postgres:17

RUN apt-get update && apt-get install -y curl postgresql-17-cron  # Match package version

# Use a shell script to configure pg_cron at runtime
RUN echo "#!/bin/bash" >> /docker-entrypoint-initdb.d/pg_cron.sh \
    && echo "echo \"shared_preload_libraries = 'pg_cron'\" >> \$PGDATA/postgresql.conf" >> /docker-entrypoint-initdb.d/pg_cron.sh \
    && echo "echo \"cron.database_name = '\$POSTGRES_DB'\" >> \$PGDATA/postgresql.conf" >> /docker-entrypoint-initdb.d/pg_cron.sh \
    && chmod +x /docker-entrypoint-initdb.d/pg_cron.sh