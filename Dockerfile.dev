# Use an official Node runtime as a parent image
FROM node:22-alpine

# Install build tools if your dev dependencies require them
RUN if [ "$NODE_ENV" = "development" ]; then \
      apk add --no-cache python3 make g++; \
    fi
    
# Create non-root user (important even for development!)
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
USER appuser

# Set working directory with proper permissions
WORKDIR /app
RUN chown -R appuser:appgroup /app

# Copy package files first for better layer caching
COPY --chown=appuser:appgroup package*.json ./

RUN npm install --include=dev

# Copy the rest of your backend code
COPY --chown=appuser:appgroup . .

# COPY --chown=appuser:appgroup entrypoint.sh /app/entrypoint.sh
# RUN chmod +x /app/entrypoint.sh

COPY --chown=appuser:appgroup entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Expose the port that your dev server uses (e.g. 5000)
EXPOSE 5000

# Run the development command with hot reload (adjust as needed)
ENTRYPOINT ["/app/entrypoint.sh"]
